

                ;-----------------------------------------------------------------------
                ; FUJIPUT.COM v1.0 -- send a file through FujiNet's N: network device.
                ;
                ;       FUJIPUT file.ext N:<url> [B|T]     e.g.  FUJIPUT HELLO.TXT N1:TNFS://192.168.1.5/HELLO.TXT T
                ;
                ; Opens the CP/M file first (fail before anything remote is touched), then
                ; opens <url> for write on FujiNet's N: device and streams the file's
                ; records up. The mirror image of FUJIGET.COM -- see that file's header
                ; and Reference/pcget-pcput/README.md for the shared lineage.
                ;
                ;-----------------------------------------------------------------------
                ; B OR T, AND B IS THE DEFAULT -- exactly W.COM's reasoning (see its own
                ; header comment for the long version): CP/M keeps no byte count, so the
                ; last record is padded with ^Z, and coming back OUT those pad bytes are
                ; indistinguishable from real data. B (default) sends every byte of every
                ; record, exactly -- a .COM survives the trip, a text file arrives with
                ; up to 127 trailing ^Z. T stops at the first ^Z -- clean for text, but
                ; TRUNCATES a binary file that happens to contain a 1AH byte, which is
                ; why it is not the default.
                ;
                ; ORDER IS LOAD-BEARING, the mirror of FUJIGET's reasoning: opening the
                ; network side for write may CREATE OR TRUNCATE a remote file, so the
                ; CP/M source must be proven to exist first. Fail first, destroy nothing.
                ;
                ; Clobbering a CP/M file is a bad day for one person; clobbering a remote
                ; file is a bad day for everyone else who uses that server. So before the
                ; real (write) open, PROBE opens the same URL read-only first: NETCMD_OPEN
                ; in read mode ACKs iff the target already exists and NAKs if not (verified
                ; live 2026-08-27, Reference/fujinet/rs232-protocol.md). If it exists, ask
                ; "Replace? (Y/N)" before ever opening for write. This only means something
                ; for a target where "exists" is meaningful (TNFS, SD, HTTP) -- a raw
                ; TCP:// stream has no file to find, so the probe just NAKs there and
                ; nothing is asked, same as "not present".
                ;
                ; AND BDOS CLOBBERS EVERY REGISTER (A,B,C,D,E,H,L -- only SP survives).
                ;-----------------------------------------------------------------------
                ; Assemble it INSIDE the machine:
                ;
                ;       ASM FUJIPUT             -> FUJIPUT.HEX
                ;       LOAD FUJIPUT            -> FUJIPUT.COM
                ;-----------------------------------------------------------------------
                
 0100                   ORG     100H
                
                ;---- CP/M ---------------------------------------------------------------
 0005 =         BDOS    EQU     0005H
 0080 =         TAIL    EQU     0080H
 005C =         TFCB    EQU     005CH           ; the CCP's own parse -- see W.ASM's INIFCB
                                                ; comment for why it's safe to use here: our
                                                ; FIRST argument is an 8.3 CP/M name, so the
                                                ; CCP's own parse is exactly right for it.
                
 0002 =         CONOUT  EQU     2
 0006 =         DIRIO   EQU     6
 0009 =         PRSTR   EQU     9
                
 000F =         FOPEN   EQU     15
 0014 =         FREAD   EQU     20              ; read sequential
 001A =         FSETDMA EQU     26
 0001 =         RDCON   EQU     1               ; console input, echoed
                
 000D =         CR      EQU     0DH
 000A =         LF      EQU     0AH
 0003 =         CTRLC   EQU     03H
 001A =         CPMEOF  EQU     1AH             ; ^Z
                
 0080 =         RECLEN  EQU     128
                
                ;---- The 2SIO card, unit b ---------------------------------------------
 0012 =         SIOST   EQU     12H
 0013 =         SIODT   EQU     13H
 0003 =         SIORST  EQU     03H
 0015 =         SIOCTL  EQU     15H
                
                ;---- The FujiNet RS232 wire protocol (Reference/fujinet/rs232-protocol.md)
 0071 =         NETDEV  EQU     71H
 004F =         CMDOPEN EQU     4FH
 0043 =         CMDCLOS EQU     43H
 0057 =         CMDWRIT EQU     57H
 0006 =         ACKCMD  EQU     06H
                
 0008 =         ACCWR   EQU     08H             ; access mode: write only
 0004 =         ACCRD   EQU     04H             ; access mode: read only (the probe)
 0000 =         TRANONE EQU     00H             ; translation: none (binary)
                
 00C0 =         SLPEND  EQU     0C0H
 00DB =         SLPESC  EQU     0DBH
 00DC =         SLPEEND EQU     0DCH
 00DD =         SLPEESC EQU     0DDH
                
 0064 =         SPECLEN EQU     100             ; room for SPEC, including the NUL
 0014 =         JUNKLEN EQU     20              ; room to park the (unused) filename token
                
                ;=======================================================================
                ; MAIN
                ;=======================================================================
 0100 313D0A    START:  LXI     SP,STACK
                
 0103 CD9203            CALL    INIFCB          ; the CCP's FCB at 5CH -> ours
 0106 CDAF03            CALL    PARSE           ; tail's 2nd/3rd words -> SPEC, MODE
 0109 3A4707            LDA     SPEC
 010C B7                ORA     A
 010D CAB904            JZ      USAGE
                
                ;---- Open the CP/M file FIRST -- the network side is untouched so far --
 0110 11C307            LXI     D,FCB
 0113 0E0F              MVI     C,FOPEN
 0115 CD0500            CALL    BDOS
 0118 FEFF              CPI     0FFH
 011A CA1002            JZ      ENOCPM
                
 011D AF                XRA     A
 011E 32E307            STA     FCB+32          ; BDOS OPEN does not promise to clear cr
                
 0121 11E707            LXI     D,BUF
 0124 0E1A              MVI     C,FSETDMA
 0126 CD0500            CALL    BDOS            ; where BDOS puts each record it reads
                
 0129 3E03              MVI     A,SIORST
 012B D312              OUT     SIOST
 012D 3E15              MVI     A,SIOCTL
 012F D312              OUT     SIOST
                
 0131 CD2E04            CALL    SAYCONN
                
                ;---- Probe read-only first: does the remote target already exist? -----
 0134 CD6A02            CALL    MKPROBE
 0137 CD0403            CALL    SENDPK
 013A CD4B03            CALL    RECVPK
 013D 3A3509            LDA     RXBUF+1
 0140 FE06              CPI     ACKCMD
 0142 C25101            JNZ     PABSENT         ; NAK -- nothing there, nothing to confirm
                
 0145 CDBE02            CALL    MKCLOSE         ; close the probe before asking
 0148 CD0403            CALL    SENDPK
 014B CD4B03            CALL    RECVPK
 014E CD1602            CALL    CKREPLACE       ; asks Y/N; exits the program if declined
                
                PABSENT:
 0151 CD4402            CALL    MKOPEN
 0154 CD0403            CALL    SENDPK
 0157 CD4B03            CALL    RECVPK
 015A 3A3509            LDA     RXBUF+1
 015D FE06              CPI     ACKCMD
 015F C20A02            JNZ     EFAIL
                
 0162 CD4404            CALL    SAYOK
                
 0165 210000            LXI     H,0
 0168 226708            SHLD    RECS
 016B AF                XRA     A
 016C 326B08            STA     LASTFLG
                
                ;-----------------------------------------------------------------------
                ; CPLOOP -- poll for a Ctrl-C abort, read one CP/M record, work out how
                ; much of it is real (all 128 in B mode; up to the first ^Z in T mode,
                ; which also ends the transfer), and write that much.
                ;-----------------------------------------------------------------------
 016F 1EFF      CPLOOP: MVI     E,0FFH
 0171 0E06              MVI     C,DIRIO
 0173 CD0500            CALL    BDOS
 0176 B7                ORA     A
 0177 CA7F01            JZ      CPGO
 017A FE03              CPI     CTRLC
 017C CAFB01            JZ      ABORT
                
 017F 11C307    CPGO:   LXI     D,FCB
 0182 0E14              MVI     C,FREAD
 0184 CD0500            CALL    BDOS
 0187 B7                ORA     A
 0188 C2EC01            JNZ     PDONE           ; 1 = EOF; anything else is also an end
                
 018B 2A6708            LHLD    RECS            ; count it now -- T mode may stop partway
 018E 23                INX     H               ; through this very record, and it was
 018F 226708            SHLD    RECS            ; still read
                
 0192 3AC207            LDA     MODE
 0195 FE54              CPI     'T'
 0197 CAA601            JZ      CPSCAN
                
 019A 3E80              MVI     A,RECLEN        ; binary: the whole record, always
 019C 326908            STA     WLEN
 019F AF                XRA     A
 01A0 326A08            STA     WLEN+1
 01A3 C3D201            JMP     CPSEND
                
                ;---- text mode: find the first ^Z in this record, if any ---------------
 01A6 21E707    CPSCAN: LXI     H,BUF
 01A9 0680              MVI     B,RECLEN
 01AB 0E00              MVI     C,0
 01AD 7E        CPS1:   MOV     A,M
 01AE FE1A              CPI     CPMEOF
 01B0 CAC501            JZ      CPSFND
 01B3 23                INX     H
 01B4 0C                INR     C
 01B5 05                DCR     B
 01B6 C2AD01            JNZ     CPS1
                
 01B9 3E80              MVI     A,RECLEN        ; no ^Z here -- send it whole, keep going
 01BB 326908            STA     WLEN
 01BE AF                XRA     A
 01BF 326A08            STA     WLEN+1
 01C2 C3D201            JMP     CPSEND
                
 01C5 79        CPSFND: MOV     A,C             ; C = how many real bytes precede the ^Z
 01C6 326908            STA     WLEN
 01C9 AF                XRA     A
 01CA 326A08            STA     WLEN+1
 01CD 3E01              MVI     A,1
 01CF 326B08            STA     LASTFLG         ; this is the last thing we send, ^Z or not
                
 01D2 3A6908    CPSEND: LDA     WLEN
 01D5 B7                ORA     A
 01D6 CAE201            JZ      CPCHK           ; nothing to send this round (^Z was byte 0)
                
 01D9 CD9002            CALL    MKWRITE
 01DC CD0403            CALL    SENDPK
 01DF CD4B03            CALL    RECVPK          ; the WRITE's ACK -- not checked, same as
                                                ; NC.ASM's MLOOP: a dropped link shows up
                                                ; some other way, and this keeps the loop
                                                ; simple for what is otherwise a one-shot
                                                ; bulk transfer
                
 01E2 3A6B08    CPCHK:  LDA     LASTFLG
 01E5 B7                ORA     A
 01E6 C2EC01            JNZ     PDONE
 01E9 C36F01            JMP     CPLOOP
                
                ;-----------------------------------------------------------------------
                ; PDONE -- close both sides, report how much went, and exit.
                ;-----------------------------------------------------------------------
 01EC CDBE02    PDONE:  CALL    MKCLOSE
 01EF CD0403            CALL    SENDPK
 01F2 CD4B03            CALL    RECVPK
 01F5 CD6C04            CALL    SAYDONE
 01F8 C30000            JMP     0
                
 01FB CDBE02    ABORT:  CALL    MKCLOSE
 01FE CD0403            CALL    SENDPK
 0201 CD4B03            CALL    RECVPK
 0204 CD5404            CALL    SAYABRT
 0207 C30000            JMP     0
                
 020A CD4C04    EFAIL:  CALL    SAYFAIL
 020D C30000            JMP     0
                
 0210 CD5C04    ENOCPM: CALL    SAYNOCPM
 0213 C30000            JMP     0
                
                ;-----------------------------------------------------------------------
                ; CKREPLACE -- the probe already found the remote target existing, and
                ; its connection is already closed. Ask before opening it again for
                ; write. Falls through (RET) if the user says yes; exits the whole
                ; program without ever opening for write if not.
                ;-----------------------------------------------------------------------
                CKREPLACE:
 0216 115B05            LXI     D,MEXIST
 0219 0E09              MVI     C,PRSTR
 021B CD0500            CALL    BDOS
 021E 214707            LXI     H,SPEC
 0221 CD1F04            CALL    PSTR
 0224 116705            LXI     D,MEXIST2
 0227 0E09              MVI     C,PRSTR
 0229 CD0500            CALL    BDOS
                
 022C 0E01              MVI     C,RDCON
 022E CD0500            CALL    BDOS
 0231 E65F              ANI     5FH             ; fold lower-case to upper
 0233 FE59              CPI     'Y'
 0235 C8                RZ                      ; yes -- proceed to the real open
                
 0236 11E104            LXI     D,MCRLF
 0239 0E09              MVI     C,PRSTR
 023B CD0500            CALL    BDOS
 023E CD6404            CALL    SAYSKIP
 0241 C30000            JMP     0
                
                ;=======================================================================
                ; BUILDING PACKETS -- see Reference/fujinet/rs232-protocol.md; identical
                ; shape to CPM Tools/NC.ASM's/FUJIGET.ASM's MKxxx routines.
                ;=======================================================================
                
 0244 216C08    MKOPEN: LXI     H,TXBUF
 0247 3671              MVI     M,NETDEV
 0249 23                INX     H
 024A 364F              MVI     M,CMDOPEN
 024C 23                INX     H
 024D 23                INX     H
 024E 23                INX     H
 024F 23                INX     H
 0250 3602              MVI     M,2             ; descr: two 1-byte params
 0252 23                INX     H
 0253 3608              MVI     M,ACCWR
 0255 23                INX     H
 0256 3600              MVI     M,TRANONE
 0258 23                INX     H
 0259 114707            LXI     D,SPEC
 025C 1A        MKO1:   LDAX    D
 025D 77                MOV     M,A
 025E 23                INX     H
 025F 13                INX     D
 0260 B7                ORA     A
 0261 C25C02            JNZ     MKO1
 0264 116C08            LXI     D,TXBUF
 0267 C3D302            JMP     SETLEN
                
                ;-----------------------------------------------------------------------
                ; MKPROBE -- exactly MKOPEN, but read-only: the overwrite-existence
                ; check. Never touches the remote target, only asks whether it's there.
                ;-----------------------------------------------------------------------
 026A 216C08    MKPROBE:LXI     H,TXBUF
 026D 3671              MVI     M,NETDEV
 026F 23                INX     H
 0270 364F              MVI     M,CMDOPEN
 0272 23                INX     H
 0273 23                INX     H
 0274 23                INX     H
 0275 23                INX     H
 0276 3602              MVI     M,2             ; descr: two 1-byte params
 0278 23                INX     H
 0279 3604              MVI     M,ACCRD
 027B 23                INX     H
 027C 3600              MVI     M,TRANONE
 027E 23                INX     H
 027F 114707            LXI     D,SPEC
 0282 1A        MKP1:   LDAX    D
 0283 77                MOV     M,A
 0284 23                INX     H
 0285 13                INX     D
 0286 B7                ORA     A
 0287 C28202            JNZ     MKP1
 028A 116C08            LXI     D,TXBUF
 028D C3D302            JMP     SETLEN
                
                ;-----------------------------------------------------------------------
                ; MKWRITE -- build a WRITE for WLEN bytes, copied from BUF. WLEN is
                ; 0..128, so its high byte is always 0 and B alone is enough to count.
                ;-----------------------------------------------------------------------
 0290 216C08    MKWRITE:LXI     H,TXBUF
 0293 3671              MVI     M,NETDEV
 0295 23                INX     H
 0296 3657              MVI     M,CMDWRIT
 0298 23                INX     H
 0299 23                INX     H
 029A 23                INX     H
 029B 23                INX     H
 029C 3605              MVI     M,5             ; descr: one 2-byte param
 029E 23                INX     H
 029F 3A6908            LDA     WLEN
 02A2 77                MOV     M,A
 02A3 23                INX     H
 02A4 3A6A08            LDA     WLEN+1
 02A7 77                MOV     M,A
 02A8 23                INX     H
 02A9 11E707            LXI     D,BUF
 02AC 3A6908            LDA     WLEN
 02AF 47                MOV     B,A
 02B0 1A        MKW1:   LDAX    D
 02B1 77                MOV     M,A
 02B2 23                INX     H
 02B3 13                INX     D
 02B4 05                DCR     B
 02B5 C2B002            JNZ     MKW1
 02B8 116C08            LXI     D,TXBUF
 02BB C3D302            JMP     SETLEN
                
 02BE 216C08    MKCLOSE:LXI     H,TXBUF
 02C1 3671              MVI     M,NETDEV
 02C3 23                INX     H
 02C4 3643              MVI     M,CMDCLOS
 02C6 23                INX     H
 02C7 23                INX     H
 02C8 23                INX     H
 02C9 23                INX     H
 02CA 3600              MVI     M,0
 02CC 23                INX     H
 02CD 116C08            LXI     D,TXBUF
 02D0 C3D302            JMP     SETLEN
                
                ;-----------------------------------------------------------------------
                ; SETLEN -- HL = one past the last byte written, DE = TXBUF's start.
                ;-----------------------------------------------------------------------
 02D3 7D        SETLEN: MOV     A,L
 02D4 93                SUB     E
 02D5 4F                MOV     C,A
 02D6 7C                MOV     A,H
 02D7 9A                SBB     D
 02D8 47                MOV     B,A
 02D9 79                MOV     A,C
 02DA 326E08            STA     TXBUF+2
 02DD 78                MOV     A,B
 02DE 326F08            STA     TXBUF+3
 02E1 AF                XRA     A
 02E2 327008            STA     TXBUF+4
 02E5 216C08            LXI     H,TXBUF
 02E8 CDEF02            CALL    CKSUM
 02EB 327008            STA     TXBUF+4
 02EE C9                RET
                
 02EF 1600      CKSUM:  MVI     D,0
 02F1 78        CK1:    MOV     A,B
 02F2 B1                ORA     C
 02F3 CA0203            JZ      CK9
 02F6 7A                MOV     A,D
 02F7 86                ADD     M
 02F8 D2FC02            JNC     CK2
 02FB 3C                INR     A
 02FC 57        CK2:    MOV     D,A
 02FD 23                INX     H
 02FE 0B                DCX     B
 02FF C3F102            JMP     CK1
 0302 7A        CK9:    MOV     A,D
 0303 C9                RET
                
                ;=======================================================================
                ; SENDING AND RECEIVING -- SLIP framing (verbatim from CPM Tools/NC.ASM)
                ;=======================================================================
 0304 3A6E08    SENDPK: LDA     TXBUF+2
 0307 4F                MOV     C,A
 0308 3A6F08            LDA     TXBUF+3
 030B 47                MOV     B,A
 030C 216C08            LXI     H,TXBUF
 030F 3EC0              MVI     A,SLPEND
 0311 CD7C03            CALL    ACOUT
 0314 78        SP1:    MOV     A,B
 0315 B1                ORA     C
 0316 CA4603            JZ      SP9
 0319 7E                MOV     A,M
 031A FEC0              CPI     SLPEND
 031C CA2A03            JZ      SPQEND
 031F FEDB              CPI     SLPESC
 0321 CA3703            JZ      SPQESC
 0324 CD7C03            CALL    ACOUT
 0327 C34103            JMP     SPADV
 032A 3EDB      SPQEND: MVI     A,SLPESC
 032C CD7C03            CALL    ACOUT
 032F 3EDC              MVI     A,SLPEEND
 0331 CD7C03            CALL    ACOUT
 0334 C34103            JMP     SPADV
 0337 3EDB      SPQESC: MVI     A,SLPESC
 0339 CD7C03            CALL    ACOUT
 033C 3EDD              MVI     A,SLPEESC
 033E CD7C03            CALL    ACOUT
 0341 23        SPADV:  INX     H
 0342 0B                DCX     B
 0343 C31403            JMP     SP1
 0346 3EC0      SP9:    MVI     A,SLPEND
 0348 C37C03            JMP     ACOUT
                
 034B CD8803    RECVPK: CALL    ACIN
 034E FEC0              CPI     SLPEND
 0350 C24B03            JNZ     RECVPK
 0353 213409            LXI     H,RXBUF
 0356 010000            LXI     B,0
 0359 CD8803    RP1:    CALL    ACIN
 035C FEC0              CPI     SLPEND
 035E CA7B03            JZ      RP9
 0361 FEDB              CPI     SLPESC
 0363 C27503            JNZ     RP3
 0366 CD8803            CALL    ACIN
 0369 FEDC              CPI     SLPEEND
 036B CA7303            JZ      RPQEND
 036E 3EDB              MVI     A,SLPESC
 0370 C37503            JMP     RP3
 0373 3EC0      RPQEND: MVI     A,SLPEND
 0375 77        RP3:    MOV     M,A
 0376 23                INX     H
 0377 03                INX     B
 0378 C35903            JMP     RP1
 037B C9        RP9:    RET
                
 037C F5        ACOUT:  PUSH    PSW
 037D DB12      AO1:    IN      SIOST
 037F E602              ANI     02H
 0381 CA7D03            JZ      AO1
 0384 F1                POP     PSW
 0385 D313              OUT     SIODT
 0387 C9                RET
                
 0388 DB12      ACIN:   IN      SIOST
 038A E601              ANI     01H
 038C CA8803            JZ      ACIN
 038F DB13              IN      SIODT
 0391 C9                RET
                
                ;=======================================================================
                ; THE CP/M FCB -- INIFCB copied from W.ASM: the CCP's FCB at 5CH -> ours.
                ; We copy rather than use it in place for exactly W.ASM's stated reason
                ; (the CCP's second FCB at 6CH overlaps the first's tail).
                ;=======================================================================
 0392 21C307    INIFCB: LXI     H,FCB
 0395 0624              MVI     B,36
 0397 3600      IF0:    MVI     M,0
 0399 23                INX     H
 039A 05                DCR     B
 039B C29703            JNZ     IF0
                
 039E 215C00            LXI     H,TFCB
 03A1 11C307            LXI     D,FCB
 03A4 060C              MVI     B,12
 03A6 7E        IF1:    MOV     A,M
 03A7 12                STAX    D
 03A8 23                INX     H
 03A9 13                INX     D
 03AA 05                DCR     B
 03AB C2A603            JNZ     IF1
 03AE C9                RET
                
                ;=======================================================================
                ; THE COMMAND TAIL
                ;
                ; Our first word is an 8.3 filename -- already in FCB via INIFCB, so we
                ; just need to skip over it here. The second word is the URL (hand-
                ; parsed, not the CCP's parse -- a URL is not an 8.3 name). The optional
                ; third word is the B|T switch, exactly W.ASM's PARSE/SETMOD/EBADSW idea,
                ; simplified since our switch always lives in a fixed third slot (W.COM's
                ; own second slot is ambiguous between a host name and a switch; ours
                ; is not, because our second slot is always the URL).
                ;=======================================================================
 03AF 218000    PARSE:  LXI     H,TAIL
 03B2 46                MOV     B,M
 03B3 23                INX     H
                
 03B4 CDF703            CALL    SKIPSP
 03B7 11AB07            LXI     D,JUNK
 03BA 0E14              MVI     C,JUNKLEN
 03BC CD0304            CALL    TOKEN           ; discard word 1 -- FCB already has it
                
 03BF CDF703            CALL    SKIPSP
 03C2 114707            LXI     D,SPEC
 03C5 0E64              MVI     C,SPECLEN
 03C7 CD0304            CALL    TOKEN           ; word 2 -> SPEC
                
 03CA CDF703            CALL    SKIPSP
 03CD 11BF07            LXI     D,SWBUF
 03D0 0E03              MVI     C,3
 03D2 CD0304            CALL    TOKEN           ; word 3 (optional) -> SWBUF
                
 03D5 3E42              MVI     A,'B'
 03D7 32C207            STA     MODE            ; default
                
 03DA 3ABF07            LDA     SWBUF
 03DD B7                ORA     A
 03DE C8                RZ                      ; no third word -- B stands
                
 03DF 3AC007            LDA     SWBUF+1
 03E2 B7                ORA     A
 03E3 C2C404            JNZ     EBADSW          ; longer than one character
                
 03E6 3ABF07            LDA     SWBUF
 03E9 FE42              CPI     'B'
 03EB C8                RZ                      ; 'B' -- matches the default already set
 03EC FE54              CPI     'T'
 03EE C2C404            JNZ     EBADSW
                
 03F1 3E54              MVI     A,'T'
 03F3 32C207            STA     MODE
 03F6 C9                RET
                
 03F7 78        SKIPSP: MOV     A,B
 03F8 B7                ORA     A
 03F9 C8                RZ
 03FA 7E                MOV     A,M
 03FB FE20              CPI     ' '
 03FD C0                RNZ
 03FE 23                INX     H
 03FF 05                DCR     B
 0400 C3F703            JMP     SKIPSP
                
 0403 79        TOKEN:  MOV     A,C
 0404 FE01              CPI     1
 0406 CA1C04            JZ      TOKEND
 0409 78                MOV     A,B
 040A B7                ORA     A
 040B CA1C04            JZ      TOKEND
 040E 7E                MOV     A,M
 040F FE20              CPI     ' '
 0411 CA1C04            JZ      TOKEND
 0414 12                STAX    D
 0415 23                INX     H
 0416 13                INX     D
 0417 05                DCR     B
 0418 0D                DCR     C
 0419 C30304            JMP     TOKEN
 041C AF        TOKEND: XRA     A
 041D 12                STAX    D
 041E C9                RET
                
                ;=======================================================================
                ; TALKING TO THE USER
                ;=======================================================================
 041F 7E        PSTR:   MOV     A,M
 0420 B7                ORA     A
 0421 C8                RZ
 0422 E5                PUSH    H
 0423 5F                MOV     E,A
 0424 0E02              MVI     C,CONOUT
 0426 CD0500            CALL    BDOS
 0429 E1                POP     H
 042A 23                INX     H
 042B C31F04            JMP     PSTR
                
 042E 11CF04    SAYCONN:LXI     D,MCONN
 0431 0E09              MVI     C,PRSTR
 0433 CD0500            CALL    BDOS
 0436 214707            LXI     H,SPEC
 0439 CD1F04            CALL    PSTR
 043C 11E104            LXI     D,MCRLF
 043F 0E09              MVI     C,PRSTR
 0441 C30500            JMP     BDOS
                
 0444 11E404    SAYOK:  LXI     D,MOK
 0447 0E09              MVI     C,PRSTR
