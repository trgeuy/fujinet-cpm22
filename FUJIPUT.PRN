 04CF 46554A4950MCONN:  DB      'FUJIPUT: opening $'
 04E1 0D0A24    MCRLF:  DB      CR,LF,'$'
 04E4 4F70656E20MOK:    DB      'Open OK. Sending...',CR,LF,'$'
 04FA 0D0A46554AMFAIL:  DB      CR,LF,'FUJIPUT: open failed.',CR,LF,'$'
 0514 0D0A46554AMABRT:  DB      CR,LF,'FUJIPUT: aborted.',CR,LF,'$'
 052A 0D0A46554AMNOCPM: DB      CR,LF,'FUJIPUT: no such CP/M file.',CR,LF,'$'
 054A 207265636FMRECS:  DB      ' records sent.',CR,LF,'$'
 055B 0D0A46554AMEXIST: DB      CR,LF,'FUJIPUT: $'
 0567 2065786973MEXIST2:DB      ' exists on the remote. Replace? (Y/N) $'
 058E 0D0A46554AMSKIP:  DB      CR,LF,'FUJIPUT: not sent.',CR,LF,'$'
 05A5 0D0A46554AMEBADSW:DB      CR,LF,'FUJIPUT: the switch is B (every byte, the default) or'
 05DC 2054202873        DB      ' T (stop at the first ^Z).',CR,LF,'$'
                
 05F9 0D0A46554AMUSAGE: DB      CR,LF,'FUJIPUT v1.0 -- send a file through FujiNet''s'
 0628 204E3A206E        DB      ' N: network device.',CR,LF,CR,LF
 063F 2020204655        DB      '   FUJIPUT file.ext N:<url> [B|T]',CR,LF,CR,LF
 0664 4578616D70        DB      'Example',CR,LF
 066D 2020204655        DB      '   FUJIPUT HELLO.TXT N1:TNFS://192.168.1.5/HELLO.TXT T',CR,LF,CR,LF
 06A7 4220287468        DB      'B (the default) sends every byte of every record, so a .COM'
 06E2 2073757276        DB      ' survives',CR,LF
 06ED 7468652074        DB      'the trip. T stops at the first ^Z, which cleans up text but'
 0728 205452554E        DB      ' TRUNCATES',CR,LF
 0734 616E797468        DB      'anything binary.',CR,LF,'$'
                
