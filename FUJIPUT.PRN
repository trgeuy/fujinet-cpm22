 0489 CD9904            CALL    DIV10
 048C C630              ADI     '0'
 048E 12                STAX    D
 048F 7C                MOV     A,H
 0490 B5                ORA     L
 0491 C28804            JNZ     PD1
 0494 0E09              MVI     C,PRSTR
 0496 C30500            JMP     BDOS
                
 0499 C5        DIV10:  PUSH    B
 049A 010000            LXI     B,0
 049D 7C        DV1:    MOV     A,H
 049E B7                ORA     A
 049F C2A804            JNZ     DV2
 04A2 7D                MOV     A,L
 04A3 FE0A              CPI     10
