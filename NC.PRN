

                ;-----------------------------------------------------------------------
                ; NC.COM v1.0 -- open a TCP connection through FujiNet, netcat-style.
                ;
                ;       NC <host> <port>                e.g.  NC 127.0.0.1 9000
                ;
                ; Bytes you type go to the connection; bytes the connection sends are
                ; printed. Ctrl-C closes the connection and exits.
                ;
                ; Talks to FujiNet's RS232 "Bus over IP" (BOIP) service, over the
                ; second unit of the console's own 88-2SIO card (sio0:b, port 12H/13H)
                ; -- see Reference/fujinet/rs232-protocol.md for the wire protocol this
                ; implements (SLIP-framed FujiBusPackets, reverse-engineered from the
                ; fujinet-firmware source and verified live against a running
                ; fujinet-pc-RS232 build). Assemble it INSIDE the machine:
                ;
                ;       ASM NC                  -> NC.HEX
                ;       LOAD NC                 -> NC.COM
                ;
                ;-----------------------------------------------------------------------
                ; THIS PROGRAM TALKS DIRECTLY TO THE 2SIO CARD, NOT TO BDOS.
                ;
                ; R.COM/W.COM/HDIR.COM (the Host Bridge tools) are pure BDOS calls,
                ; because CP/M's BDOS already understands DISKS. It has no idea what a
                ; second serial line is -- BDOS console I/O is wired to the ONE console
                ; device -- so there is no higher layer to defer to here. This program
                ; is the layer. If you move the 2SIO card, reassemble (the ports are
                ; EQUs at the top, same as every other card-specific tool in this
                ; project).
                ;
                ; AND BDOS CLOBBERS EVERY REGISTER (A,B,C,D,E,H,L -- only SP survives).
                ; Nothing may be left live in a register across CALL BDOS.
                ;-----------------------------------------------------------------------
                
 0100                   ORG     100H
                
                ;---- CP/M --------------------------------------------------------------
 0005 =         BDOS    EQU     0005H
 0080 =         TAIL    EQU     0080H           ; the command tail: length, then the text
                
 0002 =         CONOUT  EQU     2               ; E = char
 0006 =         DIRIO   EQU     6               ; direct console I/O: E=0FFH polls input
                                                ; (A=0 if none ready), else E=the char to
                                                ; output, raw, no wait, no translation
 0009 =         PRSTR   EQU     9               ; DE = string, '$'-terminated
                
 000D =         CR      EQU     0DH
 000A =         LF      EQU     0AH
 0003 =         CTRLC   EQU     03H
                
                ;---- The 2SIO card, unit b (see Reference/manual/ref/boards.md) --------
                ; sio0 base = 10H; unit a = 10H/11H (the console); unit b = 12H/13H.
 0012 =         SIOST   EQU     12H             ; status (IN) / control (OUT)
 0013 =         SIODT   EQU     13H             ; data, both ways
 0003 =         SIORST  EQU     03H             ; master reset (both counter-select bits)
 0015 =         SIOCTL  EQU     15H             ; /=16, no interrupts -- proven live against
                                                ; FujiNet-PC-RS232's BOIP channel this session
                
                ;---- The FujiNet RS232 wire protocol (Reference/fujinet/rs232-protocol.md)
 0071 =         NETDEV  EQU     71H             ; the first network device slot
 004F =         CMDOPEN EQU     4FH
 0043 =         CMDCLOS EQU     43H
 0052 =         CMDREAD EQU     52H
 0057 =         CMDWRIT EQU     57H
 0053 =         CMDSTAT EQU     53H
 0006 =         ACKCMD  EQU     06H
                
 000C =         ACCRW   EQU     0CH             ; access mode: read/write
 0000 =         TRANONE EQU     00H             ; translation: none (binary)
                
 00C0 =         SLPEND  EQU     0C0H            ; SLIP frame delimiter
 00DB =         SLPESC  EQU     0DBH            ; SLIP escape
 00DC =         SLPEEND EQU     0DCH            ; escaped 0C0H
 00DD =         SLPEESC EQU     0DDH            ; escaped 0DBH
                
 0050 =         RDMAX   EQU     80              ; largest READ this program ever asks for
 0051 =         RDMAX1  EQU     RDMAX+1
                
 0032 =         KAPASS  EQU     50              ; idle STATUS-only passes before a keepalive
                                                 ; write (see MIDLE) -- confirmed-live idle-
                                                 ; disconnect margin was ~15s at roughly
                                                 ; 20-30ms/pass; this revisits every ~1-1.5s,
                                                 ; well inside that margin
                
                ;=======================================================================
                ; MAIN
                ;=======================================================================
 0100 310608    START:  LXI     SP,STACK
 0103 AF                XRA     A
 0104 323506            STA     IDLECT          ; RAM isn't guaranteed to power up zeroed
                
 0107 CD6603            CALL    PARSE           ; command tail -> HOST, PORT
 010A 3A8905            LDA     HOST
 010D B7                ORA     A
 010E CA1404            JZ      USAGE
 0111 3ACA05            LDA     PORT
 0114 B7                ORA     A
 0115 CA1404            JZ      USAGE
                
 0118 3E03              MVI     A,SIORST        ; the ACIA out of reset...
 011A D312              OUT     SIOST
 011C 3E15              MVI     A,SIOCTL        ; ...and into a real operating mode
 011E D312              OUT     SIOST
                
 0120 CD9F03            CALL    BUILDSP         ; SPEC = "N1:TCP://host:port/",0
 0123 CDDE03            CALL    SAYCONN
                
 0126 CD1802            CALL    MKOPEN
 0129 CDD802            CALL    SENDPK
 012C CD1F03            CALL    RECVPK
 012F 3AFF06            LDA     RXBUF+1
 0132 FE06              CPI     ACKCMD
 0134 C21202            JNZ     EFAIL
                
 0137 CDF403            CALL    SAYOK
                
 013A 3E0D              MVI     A,CR            ; nudge: fujinet-firmware's fnTcpClient has a
 013C 323206            STA     WCHAR           ; confirmed upstream bug (recv(MSG_PEEK) == 0
 013F CD3E02            CALL    MKWRITE         ; misread as "closed" on a connection that's
 0142 CDD802            CALL    SENDPK          ; open but has never exchanged real data) --
 0145 CD1F03            CALL    RECVPK          ; get a line across before MLOOP can ever idle
 0148 3E0A              MVI     A,LF            ; on a STATUS-only poll, working around it
 014A 323206            STA     WCHAR           ; rather than waiting on a fujinet-firmware
 014D CD3E02            CALL    MKWRITE         ; fix. CRLF (not just CR) because a bare CR
 0150 CDD802            CALL    SENDPK          ; drew no reply from tcpbin.com -- it's
 0153 CD1F03            CALL    RECVPK          ; line-buffered, unlike fujinet's own BOIP
                                                 ; test loopback, which echoes any single byte
                                                 ; immediately.
                
                ;-----------------------------------------------------------------------
                ; MLOOP -- the interactive body. Every pass: check for a keystroke to
                ; send, then ask FujiNet for STATUS and, if it has bytes for us, READ
                ; and print them. No pacing delay -- this is a local loopback link and
                ; the host CPU is fast; see Reference/manual/serial.md on giving a
                ; machine "its real crystal" if this is ever run against a slow WAN link
                ; instead.
                ;-----------------------------------------------------------------------
 0156 1EFF      MLOOP:  MVI     E,0FFH
 0158 0E06              MVI     C,DIRIO
 015A CD0500            CALL    BDOS
 015D B7                ORA     A
 015E CA7601            JZ      MNOKEY
 0161 FE03              CPI     CTRLC
 0163 CA0302            JZ      MCLOSE
 0166 323206            STA     WCHAR
 0169 CD3E02            CALL    MKWRITE
 016C CDD802            CALL    SENDPK
 016F CD1F03            CALL    RECVPK          ; the WRITE's ACK -- not checked; a dropped
                                                 ; connection shows up as connected=0 below
 0172 AF                XRA     A
 0173 323506            STA     IDLECT          ; real traffic just went out -- not idle
                
 0176 CD7D02    MNOKEY: CALL    MKSTAT
 0179 CDD802            CALL    SENDPK
 017C CD1F03            CALL    RECVPK
                
 017F 3A0607            LDA     RXBUF+8         ; "connected"
 0182 B7                ORA     A
 0183 CAFD01            JZ      MDISC
                
 0186 3A0407            LDA     RXBUF+6         ; bytes_waiting, lo
 0189 57                MOV     D,A
 018A 3A0507            LDA     RXBUF+7         ; bytes_waiting, hi
 018D B2                ORA     D
 018E CADC01            JZ      MIDLE           ; nothing waiting -- count the idle pass
                
 0191 3A0507            LDA     RXBUF+7
 0194 B7                ORA     A
 0195 C2AA01            JNZ     MCLAMP          ; hi byte set -> certainly > RDMAX
 0198 3A0407            LDA     RXBUF+6
 019B FE51              CPI     RDMAX1
 019D D2AA01            JNC     MCLAMP          ; bw >= RDMAX+1 -> clamp
 01A0 323306            STA     REQLEN          ; else A (bw lo) is already <= RDMAX
 01A3 AF                XRA     A
 01A4 323406            STA     REQLEN+1
 01A7 C3B301            JMP     MDOREAD
 01AA 3E50      MCLAMP: MVI     A,RDMAX
 01AC 323306            STA     REQLEN
 01AF AF                XRA     A
 01B0 323406            STA     REQLEN+1
                
                MDOREAD:
 01B3 CD5E02            CALL    MKREAD
 01B6 CDD802            CALL    SENDPK
 01B9 CD1F03            CALL    RECVPK
 01BC AF                XRA     A
 01BD 323506            STA     IDLECT          ; real traffic just came in -- not idle
                
 01C0 210407            LXI     H,RXBUF+6
 01C3 3A3306            LDA     REQLEN          ; REQLEN's hi byte is always 0 (RDMAX<256)
 01C6 47                MOV     B,A
 01C7 78        MPRINT: MOV     A,B
 01C8 B7                ORA     A
 01C9 CA5601            JZ      MLOOP
 01CC 7E                MOV     A,M
 01CD 5F                MOV     E,A
 01CE 0E06              MVI     C,DIRIO
 01D0 E5                PUSH    H
 01D1 C5                PUSH    B
 01D2 CD0500            CALL    BDOS
 01D5 C1                POP     B
 01D6 E1                POP     H
 01D7 23                INX     H
 01D8 05                DCR     B
 01D9 C3C701            JMP     MPRINT
                
                ;-----------------------------------------------------------------------
                ; MIDLE -- a STATUS pass came back with nothing waiting. Count it, and
                ; every KAPASS-th consecutive idle pass, write a keepalive LF instead of
                ; going straight around again. Works around the same upstream fnTcpClient
                ; bug the post-OPEN nudge does (see there) -- confirmed live that bug can
                ; still eventually misfire an idle-but-live connection after ~15s of pure
                ; STATUS polling even once real data has already flowed both ways once;
                ; KAPASS is sized to revisit well inside that margin.
                ;-----------------------------------------------------------------------
 01DC 3A3506    MIDLE:  LDA     IDLECT
 01DF 3C                INR     A
 01E0 323506            STA     IDLECT
 01E3 FE32              CPI     KAPASS
 01E5 DA5601            JC      MLOOP           ; not yet -- go around again
 01E8 AF                XRA     A
 01E9 323506            STA     IDLECT
 01EC 3E0A              MVI     A,LF
 01EE 323206            STA     WCHAR
 01F1 CD3E02            CALL    MKWRITE
 01F4 CDD802            CALL    SENDPK
 01F7 CD1F03            CALL    RECVPK
 01FA C35601            JMP     MLOOP
                
 01FD CD0404    MDISC:  CALL    SAYDISC
 0200 C30000            JMP     0
                
 0203 CD9202    MCLOSE: CALL    MKCLOSE
 0206 CDD802            CALL    SENDPK
 0209 CD1F03            CALL    RECVPK
 020C CD0C04            CALL    SAYCLSD
 020F C30000            JMP     0
                
 0212 CDFC03    EFAIL:  CALL    SAYFAIL
 0215 C30000            JMP     0
                
                ;=======================================================================
                ; BUILDING PACKETS
                ;
                ; Each MKxxx fills TXBUF from offset 0 and finishes by calling SETLEN,
                ; which computes the header's length field from how far HL has moved,
                ; zeroes and then fills the checksum byte. See
                ; Reference/fujinet/rs232-protocol.md for the exact layout this mirrors:
                ;
                ;   off0  device      off3  length hi     off6+  params, then payload
                ;   off1  command      off4  checksum
                ;   off2  length lo    off5  descr (first descriptor byte)
                ;=======================================================================
                
 0218 213606    MKOPEN: LXI     H,TXBUF
 021B 3671              MVI     M,NETDEV
 021D 23                INX     H
 021E 364F              MVI     M,CMDOPEN
 0220 23                INX     H
 0221 23                INX     H
 0222 23                INX     H
 0223 23                INX     H               ; off2 -> off5 (skip length,length,checksum)
 0224 3602              MVI     M,2             ; descr: two 1-byte params
 0226 23                INX     H
 0227 360C              MVI     M,ACCRW
 0229 23                INX     H
 022A 3600              MVI     M,TRANONE
 022C 23                INX     H               ; -> off8: payload starts here
 022D 11D205            LXI     D,SPEC
 0230 1A        MKO1:   LDAX    D
 0231 77                MOV     M,A
 0232 23                INX     H
 0233 13                INX     D
 0234 B7                ORA     A
 0235 C23002            JNZ     MKO1            ; copy through and including the NUL
 0238 113606            LXI     D,TXBUF
 023B C3A702            JMP     SETLEN          ; tail call
                
 023E 213606    MKWRITE:LXI     H,TXBUF
 0241 3671              MVI     M,NETDEV
 0243 23                INX     H
 0244 3657              MVI     M,CMDWRIT
 0246 23                INX     H
 0247 23                INX     H
 0248 23                INX     H
 0249 23                INX     H
 024A 3605              MVI     M,5             ; descr: one 2-byte param
 024C 23                INX     H
 024D 3601              MVI     M,1             ; length lo = 1
 024F 23                INX     H
 0250 3600              MVI     M,0             ; length hi = 0
 0252 23                INX     H
 0253 3A3206            LDA     WCHAR
 0256 77                MOV     M,A             ; the one byte of payload
 0257 23                INX     H
 0258 113606            LXI     D,TXBUF
 025B C3A702            JMP     SETLEN
                
 025E 213606    MKREAD: LXI     H,TXBUF
 0261 3671              MVI     M,NETDEV
 0263 23                INX     H
 0264 3652              MVI     M,CMDREAD
 0266 23                INX     H
 0267 23                INX     H
 0268 23                INX     H
 0269 23                INX     H
 026A 3605              MVI     M,5             ; descr: one 2-byte param
 026C 23                INX     H
 026D 3A3306            LDA     REQLEN
 0270 77                MOV     M,A
 0271 23                INX     H
 0272 3A3406            LDA     REQLEN+1
 0275 77                MOV     M,A
 0276 23                INX     H
 0277 113606            LXI     D,TXBUF
 027A C3A702            JMP     SETLEN
                
 027D 213606    MKSTAT: LXI     H,TXBUF
 0280 3671              MVI     M,NETDEV
 0282 23                INX     H
 0283 3653              MVI     M,CMDSTAT
 0285 23                INX     H
 0286 23                INX     H
 0287 23                INX     H
 0288 23                INX     H
 0289 3600              MVI     M,0             ; descr: zero params
 028B 23                INX     H
 028C 113606            LXI     D,TXBUF
 028F C3A702            JMP     SETLEN
                
 0292 213606    MKCLOSE:LXI     H,TXBUF
 0295 3671              MVI     M,NETDEV
 0297 23                INX     H
 0298 3643              MVI     M,CMDCLOS
 029A 23                INX     H
 029B 23                INX     H
 029C 23                INX     H
 029D 23                INX     H
 029E 3600              MVI     M,0
 02A0 23                INX     H
 02A1 113606            LXI     D,TXBUF
 02A4 C3A702            JMP     SETLEN
                
                ;-----------------------------------------------------------------------
                ; SETLEN -- HL = one past the last byte written, DE = TXBUF's start.
                ; Stores length = HL-DE at TXBUF+2/3, then computes and stores the
                ; checksum at TXBUF+4.
                ;-----------------------------------------------------------------------
 02A7 7D        SETLEN: MOV     A,L
 02A8 93                SUB     E
 02A9 4F                MOV     C,A             ; C = length lo
 02AA 7C                MOV     A,H
 02AB 9A                SBB     D
 02AC 47                MOV     B,A             ; B = length hi
 02AD 79                MOV     A,C
 02AE 323806            STA     TXBUF+2
 02B1 78                MOV     A,B
 02B2 323906            STA     TXBUF+3
 02B5 AF                XRA     A
 02B6 323A06            STA     TXBUF+4         ; zero the checksum byte before summing
 02B9 213606            LXI     H,TXBUF
 02BC CDC302            CALL    CKSUM           ; HL,BC as above -> checksum in A
 02BF 323A06            STA     TXBUF+4
 02C2 C9                RET
                
                ;-----------------------------------------------------------------------
                ; CKSUM -- HL = buffer, BC = length. Returns the checksum in A.
                ; chk=0; for each byte: chk+=byte, folding any carry back in -- an ADD
                ; plus a conditional INR is exactly that fold on an 8080.
                ;-----------------------------------------------------------------------
 02C3 1600      CKSUM:  MVI     D,0
 02C5 78        CK1:    MOV     A,B
 02C6 B1                ORA     C
 02C7 CAD602            JZ      CK9
 02CA 7A                MOV     A,D
 02CB 86                ADD     M
 02CC D2D002            JNC     CK2
 02CF 3C                INR     A
 02D0 57        CK2:    MOV     D,A
 02D1 23                INX     H
 02D2 0B                DCX     B
 02D3 C3C502            JMP     CK1
 02D6 7A        CK9:    MOV     A,D
 02D7 C9                RET
                
                ;=======================================================================
                ; SENDING AND RECEIVING -- SLIP framing over the raw ACIA
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; SENDPK -- SLIP-frame and transmit TXBUF, using the length already
                ; stored at TXBUF+2/3.
                ;-----------------------------------------------------------------------
 02D8 3A3806    SENDPK: LDA     TXBUF+2
 02DB 4F                MOV     C,A
 02DC 3A3906            LDA     TXBUF+3
 02DF 47                MOV     B,A
 02E0 213606            LXI     H,TXBUF
 02E3 3EC0              MVI     A,SLPEND
 02E5 CD5003            CALL    ACOUT
 02E8 78        SP1:    MOV     A,B
 02E9 B1                ORA     C
 02EA CA1A03            JZ      SP9
 02ED 7E                MOV     A,M
 02EE FEC0              CPI     SLPEND
 02F0 CAFE02            JZ      SPQEND
 02F3 FEDB              CPI     SLPESC
 02F5 CA0B03            JZ      SPQESC
 02F8 CD5003            CALL    ACOUT
 02FB C31503            JMP     SPADV
 02FE 3EDB      SPQEND: MVI     A,SLPESC
 0300 CD5003            CALL    ACOUT
 0303 3EDC              MVI     A,SLPEEND
 0305 CD5003            CALL    ACOUT
 0308 C31503            JMP     SPADV
 030B 3EDB      SPQESC: MVI     A,SLPESC
 030D CD5003            CALL    ACOUT
 0310 3EDD              MVI     A,SLPEESC
 0312 CD5003            CALL    ACOUT
 0315 23        SPADV:  INX     H
 0316 0B                DCX     B
 0317 C3E802            JMP     SP1
 031A 3EC0      SP9:    MVI     A,SLPEND
 031C C35003            JMP     ACOUT           ; tail call
                
                ;-----------------------------------------------------------------------
                ; RECVPK -- read one SLIP frame into RXBUF, decoding as it goes.
                ; Returns BC = the decoded length (the same header+params+payload count
                ; SETLEN would have computed on the sending side).
                ;-----------------------------------------------------------------------
 031F CD5C03    RECVPK: CALL    ACIN
 0322 FEC0              CPI     SLPEND
 0324 C21F03            JNZ     RECVPK          ; discard anything before the opening 0C0H
 0327 21FE06            LXI     H,RXBUF
 032A 010000            LXI     B,0
 032D CD5C03    RP1:    CALL    ACIN
 0330 FEC0              CPI     SLPEND
 0332 CA4F03            JZ      RP9             ; the closing delimiter -- done
 0335 FEDB              CPI     SLPESC
 0337 C24903            JNZ     RP3
 033A CD5C03            CALL    ACIN
 033D FEDC              CPI     SLPEEND
 033F CA4703            JZ      RPQEND
 0342 3EDB              MVI     A,SLPESC        ; anything else after ESC: treat as 0DBH
 0344 C34903            JMP     RP3
 0347 3EC0      RPQEND: MVI     A,SLPEND
 0349 77        RP3:    MOV     M,A
 034A 23                INX     H
 034B 03                INX     B
 034C C32D03            JMP     RP1
 034F C9        RP9:    RET
                
                ;-----------------------------------------------------------------------
                ; ACOUT -- send the byte in A, waiting for TDRE.
                ; ACIN  -- receive a byte into A, waiting for RDRF.
                ;-----------------------------------------------------------------------
 0350 F5        ACOUT:  PUSH    PSW
 0351 DB12      AO1:    IN      SIOST
 0353 E602              ANI     02H             ; TDRE
 0355 CA5103            JZ      AO1
 0358 F1                POP     PSW
 0359 D313              OUT     SIODT
 035B C9                RET
                
 035C DB12      ACIN:   IN      SIOST
 035E E601              ANI     01H             ; RDRF
 0360 CA5C03            JZ      ACIN
 0363 DB13              IN      SIODT
 0365 C9                RET
                
                ;=======================================================================
                ; THE COMMAND TAIL AND THE DEVICE SPEC
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; PARSE -- pull HOST and PORT out of the command tail at 0080H.
                ; Same shape as R.ASM's PARSE/TOKEN/SKIPSP -- see there for why this is
                ; hand-rolled rather than the CCP's own FCB parse.
                ;-----------------------------------------------------------------------
 0366 218000    PARSE:  LXI     H,TAIL
 0369 46                MOV     B,M
 036A 23                INX     H
 036B CD7E03            CALL    SKIPSP
 036E 118905            LXI     D,HOST
 0371 CD8A03            CALL    TOKEN
 0374 CD7E03            CALL    SKIPSP
 0377 11CA05            LXI     D,PORT
 037A CD8A03            CALL    TOKEN
 037D C9                RET
                
 037E 78        SKIPSP: MOV     A,B
 037F B7                ORA     A
 0380 C8                RZ
 0381 7E                MOV     A,M
 0382 FE20              CPI     ' '
 0384 C0                RNZ
 0385 23                INX     H
 0386 05                DCR     B
 0387 C37E03            JMP     SKIPSP
                
 038A 78        TOKEN:  MOV     A,B
 038B B7                ORA     A
 038C CA9C03            JZ      TOKEND
 038F 7E                MOV     A,M
 0390 FE20              CPI     ' '
 0392 CA9C03            JZ      TOKEND
 0395 12                STAX    D
 0396 23                INX     H
 0397 13                INX     D
 0398 05                DCR     B
 0399 C38A03            JMP     TOKEN
 039C AF        TOKEND: XRA     A
 039D 12                STAX    D
 039E C9                RET
                
                ;-----------------------------------------------------------------------
                ; BUILDSP -- SPEC = "N1:TCP://" + HOST + ":" + PORT + "/" + NUL.
                ; The Nx: prefix is carried in the payload even though the packet's own
                ; device byte already selects the channel -- confirmed live; see
                ; Reference/fujinet/rs232-protocol.md, "Verified live".
                ;-----------------------------------------------------------------------
 039F 11D205    BUILDSP:LXI     D,SPEC
 03A2 211F04            LXI     H,PFXSTR
 03A5 CDC103            CALL    CATSTR
 03A8 218905            LXI     H,HOST
 03AB CDC103            CALL    CATSTR
 03AE 212904            LXI     H,COLSTR
 03B1 CDC103            CALL    CATSTR
 03B4 21CA05            LXI     H,PORT
 03B7 CDC103            CALL    CATSTR
 03BA 212B04            LXI     H,SLSTR
 03BD CDC103            CALL    CATSTR
 03C0 C9                RET
                
                ; CATSTR -- append the NUL-terminated string at HL onto the one being
                ; built at DE (DE is left pointing at the new NUL, ready for the next
                ; call -- a running cursor, not reset between calls).
 03C1 7E        CATSTR: MOV     A,M
 03C2 B7                ORA     A
 03C3 CACC03            JZ      CS9
 03C6 12                STAX    D
 03C7 23                INX     H
 03C8 13                INX     D
 03C9 C3C103            JMP     CATSTR
 03CC AF        CS9:    XRA     A
 03CD 12                STAX    D
 03CE C9                RET
                
                ;=======================================================================
                ; TALKING TO THE USER
                ;=======================================================================
                
                ; PSTR -- print the NUL-terminated string at HL, one BDOS call at a
                ; time (so nothing needs to survive BDOS clobbering every register).
 03CF 7E        PSTR:   MOV     A,M
 03D0 B7                ORA     A
 03D1 C8                RZ
 03D2 E5                PUSH    H
 03D3 5F                MOV     E,A
 03D4 0E02              MVI     C,CONOUT
 03D6 CD0500            CALL    BDOS
 03D9 E1                POP     H
 03DA 23                INX     H
 03DB C3CF03            JMP     PSTR
                
 03DE 112D04    SAYCONN:LXI     D,MCONN
 03E1 0E09              MVI     C,PRSTR
 03E3 CD0500            CALL    BDOS
 03E6 21D205            LXI     H,SPEC
 03E9 CDCF03            CALL    PSTR
 03EC 114004            LXI     D,MCRLF
 03EF 0E09              MVI     C,PRSTR
 03F1 C30500            JMP     BDOS
                
 03F4 114304    SAYOK:  LXI     D,MOK
 03F7 0E09              MVI     C,PRSTR
 03F9 C30500            JMP     BDOS
                
 03FC 116104    SAYFAIL:LXI     D,MFAIL
 03FF 0E09              MVI     C,PRSTR
 0401 C30500            JMP     BDOS
                
 0404 117C04    SAYDISC:LXI     D,MDISCM
 0407 0E09              MVI     C,PRSTR
 0409 C30500            JMP     BDOS
                
 040C 11A104    SAYCLSD:LXI     D,MCLSDM
 040F 0E09              MVI     C,PRSTR
 0411 C30500            JMP     BDOS
                
 0414 11B104    USAGE:  LXI     D,MUSAGE
 0417 0E09              MVI     C,PRSTR
 0419 CD0500            CALL    BDOS
 041C C30000            JMP     0
                
                ;=======================================================================
                ; DATA
                ;=======================================================================
 041F 4E313A5443PFXSTR: DB      'N1:TCP://',0
 0429 3A00      COLSTR: DB      ':',0
 042B 2F00      SLSTR:  DB      '/',0
                
 042D 4E433A2063MCONN:  DB      'NC: connecting to $'
 0440 0D0A24    MCRLF:  DB      CR,LF,'$'
 0443 436F6E6E65MOK:    DB      'Connected. Ctrl-C to close.',CR,LF,'$'
 0461 0D0A4E433AMFAIL:  DB      CR,LF,'NC: connection failed.',CR,LF,'$'
 047C 0D0A4E433AMDISCM: DB      CR,LF,'NC: connection closed by remote.',CR,LF,'$'
 04A1 0D0A4E433AMCLSDM: DB      CR,LF,'NC: closed.',CR,LF,'$'
                
 04B1 0D0A4E4320MUSAGE: DB      CR,LF,'NC v1.0 -- open a TCP connection through FujiNet.',CR,LF,CR,LF
 04E8 2020204E43        DB      '   NC <host> <port>',CR,LF,CR,LF
 04FF 4578616D70        DB      'Example',CR,LF
 0508 2020204E43        DB      '   NC 127.0.0.1 9000',CR,LF,CR,LF
 0520 4279746573        DB      'Bytes typed go to the connection; bytes received are'
 0554 207072696E        DB      ' printed.',CR,LF
 055F 4374726C2D        DB      'Ctrl-C closes the connection and exits.',CR,LF,'$'
                
                ;---- Variables ---------------------------------------------------------
 0589           HOST:   DS      65              ; up to 64 characters + NUL
 05CA           PORT:   DS      8
 05D2           SPEC:   DS      96              ; "N1:TCP://" + HOST + ":" + PORT + "/" + 0
 0632           WCHAR:  DS      1
 0633           REQLEN: DS      2
 0635           IDLECT: DS      1               ; consecutive idle STATUS-only passes (MIDLE)
                
 0636           TXBUF:  DS      200
 06FE           RXBUF:  DS      200
                
 07C6                   DS      64              ; stack
 0806 =         STACK   EQU     $
                
 0806                   END     START
